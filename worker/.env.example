# Copy to .env and fill in.

# Public SpyGlass V2 address used by the Mac mini worker.
WORKER_BASE_URL=https://spyglass2.sentinel2.org

# The WORKER_TOKEN secret from the app (Project Settings -> Secrets).
WORKER_TOKEN=paste-the-token-here

# Where the logged-in Chromium profile lives. Log in to Facebook once with
#   python -m worker.login
# and this profile keeps the session.
CHROME_PROFILE_DIR=~/fbem/chrome-profile

# Where captured files are written before upload (kept as a local backup).
WORK_DIR=~/fbem/captures

# Fallback handler name recorded in the custody log when a job has none.
DEFAULT_HANDLER=M. Hafidz
WORKER_VERSION=worker-1.0.0

# Seconds between heartbeats and between queue polls.
HEARTBEAT_SECONDS=60
POLL_SECONDS=5
# Captures that may run at the same time (1-4). Each extra one uses a copy of the logged-in Chrome profile.
MAX_CONCURRENT=4
