# Copy to gateway/.env on the Mac Studio. Never commit the real .env.

# DarkNight, as the read-only user (see README: "Create the read-only database user").
DARKNIGHT_DATABASE_URL=postgresql://evidence_hub_ro:CHANGE_ME@localhost:5432/darknight

# Evidence share as mounted on the Mac Studio (read-only NAS account).
NAS_EVIDENCE_ROOT=/Volumes/Evidence/darknight

# The Evidence Hub's backend: the same values as VITE_SUPABASE_URL and the anon key.
SUPABASE_URL=https://aogdbcwqrdnnqvjsrrqn.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
# Leave empty unless the project signs tokens with a shared HS256 secret.
SUPABASE_JWT_SECRET=

# Browser origins allowed to call the gateway: the hub's published address and preview.
GATEWAY_ALLOWED_ORIGINS=https://spyglass2.sentinel2.org,https://project--a91d8941-73a8-4bf1-b81c-478687c7171c-dev.lovable.app

# Gateway state: hash cache and the home custody log.
GATEWAY_STATE_DIR=/Users/hermes/darknight-gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
